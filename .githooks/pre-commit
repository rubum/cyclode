#!/usr/bin/env bash
set -e

# ========================================================
# Cyclode Pre-Commit Hook
# Ultra-fast sanity checks (< 0.5s) on staged files
# ========================================================

# 1. Prevent accidental secret commits (.env files, private keys)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

for file in $STAGED_FILES; do
    case "$file" in
        *.env|.env.*|*.pem|*id_rsa*|*.key)
            echo "❌ Blocked: Refusing to commit secret or credential file: $file"
            exit 1
            ;;
    esac
done

# 2. Check staged Python files for syntax errors and undefined symbols (F821)
STAGED_PY=$(echo "$STAGED_FILES" | grep -E '\.py$' || true)
if [ -n "$STAGED_PY" ]; then
    if command -v ruff >/dev/null 2>&1; then
        ruff check $STAGED_PY --select=F821,E9 --no-fix || {
            echo "❌ Ruff lint check failed. Undefined variable or syntax error in staged files."
            exit 1
        }
    elif docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^cyclode-backend$" && docker exec cyclode-backend which ruff >/dev/null 2>&1; then
        CONTAINER_PY=""
        for f in $STAGED_PY; do
            if [[ "$f" =~ ^backend/(.*) ]]; then
                CONTAINER_PY="$CONTAINER_PY ${BASH_REMATCH[1]}"
            fi
        done
        if [ -n "$CONTAINER_PY" ]; then
            docker exec cyclode-backend ruff check $CONTAINER_PY --select=F821,E9 || {
                echo "❌ Ruff lint check failed in container. Undefined variable or syntax error."
                exit 1
            }
        fi
    else
        for pyf in $STAGED_PY; do
            if [ -f "$pyf" ]; then
                python3 -m py_compile "$pyf" || {
                    echo "❌ Python syntax check failed on $pyf"
                    exit 1
                }
            fi
        done
    fi
fi

# 3. Check staged JSON files for valid JSON
STAGED_JSON=$(echo "$STAGED_FILES" | grep -E '\.json$' || true)
if [ -n "$STAGED_JSON" ]; then
    for jf in $STAGED_JSON; do
        if [ -f "$jf" ]; then
            python3 -m json.tool "$jf" > /dev/null || {
                echo "❌ Invalid JSON syntax in $jf"
                exit 1
            }
        fi
    done
fi

exit 0
