#!/usr/bin/env bash
set -e

# ========================================================
# Cyclode Pre-Push Hook
# Fast integration checks (< 5s) before pushing to remote
# ========================================================

echo "🚀 Running Cyclode pre-push verification..."

# 1. Validate Docker Compose configuration
if command -v docker >/dev/null 2>&1; then
    docker compose config -q || {
        echo "❌ docker-compose.yml configuration is invalid!"
        exit 1
    }
fi

# 2. Check full backend codebase with Ruff for undefined variables (F821) and fatal syntax errors (E9)
if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^cyclode-backend$"; then
    echo "⚡ Checking backend for undefined variables and syntax errors..."
    docker exec cyclode-backend ruff check app/ --select=F821,E9 || {
        echo "❌ Undefined variables or syntax errors detected in backend!"
        exit 1
    }
fi

echo "✅ Pre-push verification passed! Proceeding with push."
exit 0
