# Server & Ports
PORT=8000
FRONTEND_PORT=5174
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=adappty-super-secret-key-change-in-production

# Workspace & Storage
WORKSPACE_ROOT=/workspaces
DATABASE_URL=sqlite+aiosqlite:////data/adappty.db

# Antigravity Agent Harness Configuration
ANTIGRAVITY_MODEL=gemini-3.7-flash
ANTIGRAVITY_ENABLE_THINKING=true
ANTIGRAVITY_MAX_PARALLEL_WORKERS=5
ANTIGRAVITY_EXECUTION_TIMEOUT_SECONDS=600

# Action Approval Policies (auto | require_approval | disabled)
POLICY_GIT_PUSH=require_approval
POLICY_CREATE_PR=require_approval
POLICY_POST_COMMENTS=auto
POLICY_SLACK_NOTIFY=auto
POLICY_MERGE_PR=require_approval
POLICY_EXECUTE_SHELL=auto

# Plug-and-Play Integrations
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=adappty_gh_webhook_secret_123

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=#adappty-agents

APPSIGNAL_API_KEY=
APPSIGNAL_APP_ID=
APPSIGNAL_WEBHOOK_TOKEN=adappty_appsignal_token_123
